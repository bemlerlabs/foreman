# Rust / cargo-near build output (the reviewed WASM artifacts live in artifacts/ and are tracked)
target/
dist/
.webpack/
.next/
neardev/

# Node
node_modules/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
.venv-receipts/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Secrets and local runtime state — never commit these.
# Keys are generated by the operator; see docs/DEPLOYMENT.md for the expected paths.
.env
.env.*
!.env.example
credentials/
keys/

# Local demo runtime (agent learning state and node state, not part of the repo)
.ephe/
.state/

# OS
.DS_Store

# WASM is ignored by default because cargo writes it into target/; the two checked-in
# binaries below are deliberate review artifacts.
*.wasm
!artifacts/*.wasm
!artifacts/worker/latency_stats.wasm
