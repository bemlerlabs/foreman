# Secrets — NEVER commit. Local .env only (keys belong in environment variables, never in the repository.)
INTENTS_API_KEY=            # naa_… from partners.near-intents.org (T0 requirement)
INTENTS_BASE_URL=https://api.agentsonintents.com
NEAR_AI_API_KEY=            # cloud.near.ai (10$ via nearbuilders.org/join)
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_RPC_MAINNET=https://free.rpc.fastnear.com
NEAR_RPC_BACKUP=https://rpc.ankr.com/near
NEAR_RPC_TESTNET=https://test.rpc.fastnear.com
# --- Accounts (separate identities, RULES.md §Security) ---
OWNER_ACCOUNT=              # human payout/demo account (.testnet or .near)
CONTRACT_ACCOUNT=           # foreman.<org>.testnet
TREASURY_ACCOUNT=           # ONE treasury via the Intents Agent API
FOREMAN_ACCOUNT=            # foreman AGENT account (receives the fee)
SWARM_ACCOUNTS=agent1.,agent2.,agent3.,agent4.,agent5.   # + .<org>.testnet
# --- Demo discipline (Q-007) ---
AGENT_EXECUTE=false         # true only after the dry:true proof; never the default
DEMO_MAX_USD=3
# --- Agent Market ---
MARKET_AGENT_TOKEN=         # aat_… from market.near.ai
MARKET_MCP=https://market.near.ai/mcp
# --- Ephemora Cell ---
EPHEMORA_VERSION_PIN=       # pinned version (solo maintainer!)
RECEIPT_KEY_PATH=keys/cell_key.pem
