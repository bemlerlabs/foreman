# Secrets — NIE committen. Nur .env lokal (Key belongs in environment variables, never in the repository.)
INTENTS_API_KEY=            # naa_… aus partners.near-intents.org (T0-Pflicht)
INTENTS_BASE_URL=https://api.agentsonintents.com
NEAR_AI_API_KEY=            # cloud.near.ai (10$ via nearbuilders.org/join)
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_RPC_MAINNET=https://free.rpc.fastnear.com
NEAR_RPC_BACKUP=https://rpc.ankr.com/near
NEAR_RPC_TESTNET=https://test.rpc.fastnear.com
# --- Konten (getrennte Identitäten, RULES.md §Sicherheit) ---
OWNER_ACCOUNT=              # Mensch-Payout-/Demo-Konto (.testnet bzw. .near)
CONTRACT_ACCOUNT=           # foreman.<org>.testnet
TREASURY_ACCOUNT=           # EIN Treasury über Intents Agent API
FOREMAN_ACCOUNT=            # foreman-AGENT-Konto (Payout der Fee)
SWARM_ACCOUNTS=agent1.,agent2.,agent3.,agent4.,agent5.   # + .<org>.testnet
# --- Demo-Disziplin (Q-007) ---
AGENT_EXECUTE=false         # true erst nach dry:true-Beweis; nie default
DEMO_MAX_USD=3
# --- Agent Market ---
MARKET_AGENT_TOKEN=         # aat_… aus market.near.ai
MARKET_MCP=https://market.near.ai/mcp
# --- Ephemora Cell ---
EPHEMORA_VERSION_PIN=       # gepinnte Version (Solo-Maintner!)
RECEIPT_KEY_PATH=keys/cell_key.pem
